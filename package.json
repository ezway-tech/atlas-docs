{
  "name": "atlas-docs-root",
  "private": true,
  "scripts": {
    "package:release": "node scripts/build/package-release.mjs",
    "test:cli": "node --test scripts/tests/cli/test-cli.mjs",
    "test:core": "node --test scripts/tests/library/*.test.mjs",
    "test:package": "node scripts/tests/package/test-package.mjs",
    "test:upgrade-artifacts": "node scripts/tests/package/test-upgrade-artifacts.mjs",
    "check:distribution": "npm run check && npm run test:core && npm run test:cli",
    "setup": "npm --prefix app install",
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "start": "npm --prefix app start",
    "bootstrap": "npm --prefix app run bootstrap",
    "seed:demo": "npm --prefix app run seed:demo",
    "typecheck": "npm --prefix app run typecheck",
    "check": "npm run typecheck && npm --prefix app run test:storage"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
