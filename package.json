{
  "name": "atlas-docs-root",
  "private": true,
  "scripts": {
    "package:release": "node scripts/package-release.mjs",
    "test:cli": "node --test scripts/test-cli.mjs",
    "test:package": "node scripts/test-package.mjs",
    "setup": "npm --prefix app install",
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "start": "npm --prefix app start",
    "bootstrap": "npm --prefix app run bootstrap",
    "seed:demo": "npm --prefix app run seed:demo",
    "typecheck": "npm --prefix app run typecheck",
    "test:storage": "npm --prefix app run test:storage",
    "test:backup": "npm --prefix app run test:backup",
    "test:backup-load": "npm --prefix app run test:backup-load",
    "test:storage-stats": "npm --prefix app run test:storage-stats",
    "test:references": "npm --prefix app run test:references",
    "test:history-policy": "npm --prefix app run test:history-policy",
    "test:library-ui": "npm --prefix app run test:library-ui",
    "test:i18n": "npm --prefix app run test:i18n",
    "test:resources": "npm --prefix app run test:resources",
    "test:demo": "npm --prefix app run test:demo",
    "test:ui": "npm --prefix app run test:ui",
    "test:headings": "npm --prefix app run test:headings",
    "test:responsive": "npm --prefix app run test:responsive",
    "check": "npm run typecheck && npm run test:storage",
    "docker:up": "docker compose up -d --build",
    "docker:stop": "docker compose stop",
    "docker:logs": "docker compose logs -f",
    "docker:status": "docker compose ps"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
