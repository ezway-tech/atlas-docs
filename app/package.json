{
  "name": "atlas-docs",
  "version": "5.3.0",
  "private": true,
  "scripts": {
    "predev": "node ../scripts/build/prepare-help.mjs && node ../scripts/setup/bootstrap.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prestart": "node ../scripts/setup/bootstrap.mjs",
    "start": "next start --hostname 0.0.0.0",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "bootstrap": "node ../scripts/setup/bootstrap.mjs",
    "seed:demo": "node ../scripts/setup/seed-demo.mjs",
    "test:storage": "node ../scripts/tests/app/test-storage.mjs",
    "test:backup": "node --experimental-strip-types ../scripts/tests/app/test-backup.mjs",
    "test:backup-load": "node --experimental-strip-types ../scripts/tests/app/test-backup-load.mjs",
    "test:storage-stats": "node --experimental-strip-types ../scripts/tests/app/test-storage-stats.mjs",
    "test:references": "node --experimental-strip-types ../scripts/tests/app/test-references.mjs",
    "test:history-policy": "node --experimental-strip-types ../scripts/tests/app/test-history-policy.mjs",
    "test:library-ui": "node ../scripts/tests/app/test-library-ui.mjs",
    "test:i18n": "node ../scripts/tests/app/test-i18n.mjs",
    "test:demo": "node ../scripts/tests/app/test-demo.mjs",
    "test:resources": "node --experimental-strip-types ../scripts/tests/app/test-resources.mjs",
    "test:history-diff": "node --experimental-strip-types ../scripts/tests/app/test-history-diff.mjs",
    "test:ui": "playwright test",
    "test:headings": "node ../scripts/tests/app/test-headings.mjs",
    "test:responsive": "node ../scripts/tests/app/test-responsive.mjs",
    "prebuild": "node ../scripts/build/prepare-help.mjs",
    "pretypecheck": "node ../scripts/build/prepare-help.mjs",
    "test:help": "node ../scripts/tests/app/test-help.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-select": "^2.4.1",
    "@tiptap/extension-image": "3.30.3",
    "@tiptap/markdown": "3.30.3",
    "@tiptap/pm": "3.30.3",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "@xyflow/react": "^12.12.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "lowdb": "^7.0.1",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.12.1",
    "minisearch": "^7.1.0",
    "next": "^15.5.3",
    "node-sql-parser": "^5.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "swagger-ui-react": "^5.34.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
